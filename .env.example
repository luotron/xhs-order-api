# ===== 应用级配置（复制本文件为 .env 并填写，首次启动自动同步进 DB）=====
# 小红书开放平台 AppId（控制台-应用管理-应用详情）
APP_ID=
# App Secret（应用详情页，点"显示"查看）
APP_SECRET=
# 应用授权回调地址（与开放平台控制台配置保持一致；指向本服务则填 https://你的域名/callback/xhs/oauth）
APP_REDIRECT_URI=

# ===== 服务配置 =====
PORT=8899

# ===== 网关配置（默认生产环境）=====
# 生产：https://ark.xiaohongshu.com/ark/open_api/v3/common_controller
# 测试：https://ark.sit.xiaohongshu.com/ark/open_api/v3/common_controller
XHS_GATEWAY=https://ark.xiaohongshu.com/ark/open_api/v3/common_controller
# 开放平台授权页面（控制台"复制授权链接"）
XHS_AUTHORIZE_URL=https://ark.xiaohongshu.com/ark/authorization

# token 自动刷新：提前多少毫秒视为即将过期（默认 10 分钟）
TOKEN_REFRESH_AHEAD_MS=600000
# 刷新调度间隔（毫秒）
REFRESH_SWEEP_INTERVAL_MS=300000

# SQLite 文件位置
DB_PATH=./data/xhs.db

# ===== 成功订单监听与上报 =====
# 监听轮询间隔（毫秒），每 10 秒查一次所有店铺
MONITOR_INTERVAL_MS=10000
# 每次轮询的更新时间窗口（分钟，平台限制 timeType=2 上限 30）
MONITOR_WINDOW_MINUTES=30
# 启动时回填最近多少分钟的已完成订单（默认 60 分钟）
MONITOR_BACKFILL_MINUTES=60
# 上报接口地址（TODO：上报接口待定，留空则仅打印日志）
REPORT_URL=
# 上报失败重试次数
REPORT_RETRY_TIMES=3
# 重试间隔基数（毫秒）：第 n 次失败后等待 n*该值 再重试
REPORT_RETRY_BACKOFF_MS=2000
